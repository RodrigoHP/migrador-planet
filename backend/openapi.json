    "/api/v1/health": {
      "get": {
        "summary": "Health",
        "description": "Deep health check endpoint.\n\nSYS-017: Verifies all dependencies (Redis, Supabase DB, Storage bucket,\nspaCy model) and returns per-component status with latency.\nReturns overall 'ok' only when all primary services are healthy.\nReturns 'degraded' when secondary services (spaCy) are unavailable.\n\nREDIS-002: Includes Redis connectivity status so load balancers and\nmonitoring systems can detect when Redis is unreachable.\n\nSYS-019 (API versioning): Canonical path is /api/v1/health.\nBackward-compatible alias /api/health is registered below.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
