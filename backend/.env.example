# OpenRouter API Key — obrigatório para Vision AI
# Obtenha em: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-key-here

# IMPORTANTE: Reinicie o backend (uvicorn) após alterar este arquivo para recarregar as variáveis.

# Storage mode — REQUIRED. Choose 'local' (dev) or 'supabase' (production).
# No default — the app will fail to start if this is not set.
STORAGE_MODE=local

# Authentication — Supabase JWT verification
# Set AUTH_DISABLED=true for local dev (no auth required)
AUTH_DISABLED=true
# SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-project-settings

# Configurações do servidor
# HOST=0.0.0.0
# PORT=8000

# CORS — comma-separated origins allowed to call the API
# Default: http://localhost:5173 (Vite dev server)
# Production example: https://migrador-planet.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Directory for temporary job files
# Default: /tmp/jobs
JOBS_DIR=/tmp/jobs

# Rate limiting
# Default: 10/minute for /api/analyze, 30/minute for all other routes
RATE_LIMIT_ANALYZE=10/minute
RATE_LIMIT_GLOBAL=30/minute

# Upload limits
# Default: 50MB per PDF, 500 pages total
MAX_FILE_SIZE_MB=50
MAX_PAGE_COUNT=500

# Redis — optional. If set, job state persists across server restarts.
# Railway provides a free Redis addon: redis://default:xxx@host:port
# REDIS_URL=redis://localhost:6379
