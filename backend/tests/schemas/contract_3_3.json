{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contract 3.3 — Stage 3 output validation",
  "description": "Validates document_trees and intelligence output from Stage 3. document_trees is Dict[cluster_id, tree] since RCA 2026-03-31.",
  "type": "object",
  "required": ["document_trees", "intelligence"],
  "properties": {
    "document_trees": {
      "type": "object",
      "description": "Dict keyed by cluster_id. Each value is the document tree for that cluster.",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "children"],
        "properties": {
          "id": { "type": "string" },
          "type": { "const": "document" },
          "children": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "children"],
              "properties": {
                "type": { "const": "page" },
                "children": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["type", "children"],
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": ["header", "flow", "footer", "repeated_section"]
                      },
                      "source": {
                        "type": "string",
                        "enum": ["visual", "threshold", "drawn"]
                      },
                      "children": { "type": "array" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "intelligence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["block_classifications", "classification_quality"],
        "properties": {
          "block_classifications": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["semantic", "stability", "variant", "confidence"],
              "properties": {
                "semantic": {
                  "type": "string",
                  "enum": ["label", "dynamic", "semi_dynamic", "likely_dynamic", "unknown"]
                },
                "stability": {
                  "type": "string",
                  "enum": ["stable", "variable", "rare", "unknown"]
                },
                "variant": {
                  "type": "string",
                  "enum": ["required", "optional", "conditional"]
                },
                "presence_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
                "pdf_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "field_pair": { "type": ["string", "null"] },
                "smart_signals": {
                  "type": ["array", "null"],
                  "items": { "type": "string" }
                }
              }
            }
          },
          "labels": {
            "type": "array",
            "items": { "type": "string" }
          },
          "dynamic_fields": {
            "type": "array",
            "items": { "type": "string" }
          },
          "optional_fields": {
            "type": "array",
            "items": { "type": "string" }
          },
          "conditional_fields": {
            "type": "array",
            "items": { "type": "string" }
          },
          "classification_quality": {
            "type": "object",
            "required": ["total_pdfs", "total_pages_in_cluster", "statistical_strength"],
            "properties": {
              "total_pdfs": { "type": "integer", "minimum": 0 },
              "total_pages_in_cluster": { "type": "integer", "minimum": 0 },
              "statistical_strength": {
                "type": "string",
                "enum": ["none", "weak", "strong"]
              },
              "smart_override_count": { "type": "integer", "minimum": 0 },
              "uncertain_count": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
