{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contract 3.4 — Stage 4 output validation",
  "description": "Validates field_mappings, format_functions, confidence_scores, and validation_result from Stage 4",
  "type": "object",
  "required": ["field_mappings", "format_functions", "confidence_scores", "validation_result"],
  "properties": {
    "field_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["block_id", "layout_type_id", "xsd_field_path", "confidence"],
        "properties": {
          "block_id": { "type": "string" },
          "layout_type_id": { "type": "string" },
          "pdf_text": { "type": "string" },
          "label_text": { "type": "string" },
          "bbox": {
            "oneOf": [
              {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 4,
                "maxItems": 4
              },
              { "type": "null" }
            ]
          },
          "xsd_field_path": { "type": "string" },
          "xsd_type": { "type": ["string", "null"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "is_ambiguous": { "type": "boolean" },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "score"],
              "properties": {
                "path": { "type": "string" },
                "score": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          },
          "page_number": { "type": "integer", "minimum": 0 },
          "pdf_id": { "type": "string" },
          "is_table_cell": { "type": "boolean" },
          "from_table": { "type": "boolean" },
          "detected_format": { "type": ["string", "null"] },
          "smart_signals": {
            "oneOf": [
              { "type": "array", "items": { "type": "string" } },
              { "type": "null" }
            ]
          },
          "semantic_confirmed": { "type": ["string", "null"] },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "type": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["mapped", "unmapped", "ambiguous"]
          },
          "isOptional": { "type": "boolean" }
        }
      }
    },
    "format_functions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "confidence_scores": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["overall", "status"],
        "properties": {
          "layout_stability": { "type": "number", "minimum": 0, "maximum": 1 },
          "anchor_detection": { "type": "number", "minimum": 0, "maximum": 1 },
          "grid_quality": { "type": "number", "minimum": 0, "maximum": 1 },
          "field_variability": { "type": "number", "minimum": 0, "maximum": 1 },
          "vision_agreement": { "type": "number", "minimum": 0, "maximum": 1 },
          "overall": { "type": "number", "minimum": 0, "maximum": 100 },
          "status": {
            "type": "string",
            "enum": ["approved", "review_recommended", "human_review_required"]
          }
        }
      }
    },
    "validation_result": {
      "type": "object",
      "required": ["warnings", "errors"],
      "properties": {
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "errors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "orphan_count": { "type": "integer", "minimum": 0 },
        "unmapped_xsd_fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "unmapped_required_xsd_fields": {
          "type": "array",
          "items": { "type": "string" }
        },
        "type_format_mismatches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "block_id": { "type": "string" },
              "xsd_type": { "type": "string" },
              "detected_format": { "type": "string" },
              "xsd_path": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
