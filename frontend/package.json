{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . && vue-tsc --noEmit",
    "lint:fix": "eslint . --fix && prettier --write \"src/**/*.{ts,vue,json,css,scss}\"",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,vue,json,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,json,css,scss}\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "generate:types": "openapi-typescript ../backend/openapi.json --output src/types/generated/pipeline-api.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.1",
    "@vueuse/core": "^14.2.1",
    "chart.js": "^4.5.1",
    "dompurify": "^3.3.3",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^0.577.0",
    "monaco-editor": "^0.55.1",
    "pdfjs-dist": "^5.5.207",
    "pinia": "^3.0.4",
    "vue": "^3.5.25",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.3.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.2.1",
    "@types/dompurify": "^3.0.5",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.0",
    "lint-staged": "^16.4.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.8",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.1.5"
  }
}
